# ── voicebot — example environment ───────────────────────────────────────────
# Copy to `.env` and fill in. NEVER commit `.env`. All values are read from env;
# nothing is hardcoded. (SECURITY_POLICY §1: any key previously present in a real
# `.env` is treated as COMPROMISED and must be rotated — see DECISION_LOG DL-0002.)
#
# The voicebot is the Phase-1 local prototype (Constitution: promoted into the
# Runtime Plane at migration M2). Provider names below are the current
# Implementation Profile (Constitution Part B), not architecture.

# Large Language Model + Speech-to-Text provider (current profile: Groq)
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_LLM_MODEL=llama-3.3-70b-versatile

# Text-to-Speech provider (current profile: Cartesia)
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=

# Optional: override the system prompt for local experiments
# VOICEBOT_SYSTEM_PROMPT=
