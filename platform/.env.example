# ─── VoxVoice Platform — example environment ───────────────────────────────
# Copy to `.env` and fill in. NEVER commit `.env`. All secrets are read from
# env; nothing is hardcoded. (Assume any keys previously seen in chat history
# are rotated — do not reuse old values.)

# App
APP_ENV=dev

# Engine selection — the ONLY place a consumer/operator picks the engine.
# Swapping engines must touch nothing but this value + the adapter code.
#   dograh   -> DograhAdapter (primary, web sessions working)
#   livekit  -> LiveKitAdapter (stub for now, raises NotImplementedError)
ENGINE=dograh

# Database. SQLite locally; swap for a Supabase/Postgres URL in prod with NO
# model changes, e.g. postgresql+psycopg://USER:PASS@HOST:5432/postgres
DATABASE_URL=sqlite:///./voxvoice.db

# ─── Dograh (self-hosted) ──────────────────────────────────────────────────
# VERIFIED against Dograh v1.35.0. REST API host root (the adapter appends
# /api/v1). Official compose maps the api service to host :8000; if 8000 is
# taken, remap it (this repo verified against :8010). The UI/embed host is :3010.
DOGRAH_BASE_URL=http://localhost:8000
DOGRAH_UI_BASE_URL=http://localhost:3010
# Dograh API key (Bearer). Create one in the Dograh UI (Settings → API keys) or
# via `POST /api/v1/user/api-keys` after signup/login; it looks like `dgr_…`.
DOGRAH_API_KEY=

# Shared secret Dograh must present (header x-engine-secret) when it POSTs
# transcript/call events back to /v1/engine/dograh/events. Generate a random
# value; this protects the ingestion endpoint.
ENGINE_CALLBACK_SECRET=change-me-engine-callback-secret

# ─── Webhooks out to consumers ─────────────────────────────────────────────
# Per SPEC §10 open-decision 4: webhook config defaults to columns on Org
# (webhook_url / webhook_secret). These two values are only fallbacks used
# when an Org has no webhook configured of its own.
DEFAULT_WEBHOOK_URL=
DEFAULT_WEBHOOK_SECRET=

# ─── Provider credentials (ADR-0049) ───────────────────────────────────────
# Resolved ONLY by the composition root (`bootstrap.py`) through the injected
# CredentialProvider; the default EnvCredentialProvider reads
# VOXVOICE_SECRET_<NAME>. Provider plugins never read the environment.
# Documented by NAME only — never put a real value in this file.
#
# Deepgram streaming STT (M11.6). Required only when the `deepgram` STT profile
# is selected; the profile refuses to start without it (no local fallback).
VOXVOICE_SECRET_DEEPGRAM_API_KEY=
#
# Groq streaming LLM (M11.9). Required only when the `groq` LLM profile is
# selected; the profile refuses to start without it (no fallback to EchoLLM).
VOXVOICE_SECRET_GROQ_API_KEY=
#
# Cartesia streaming TTS (M11.10). Required only when the `cartesia` TTS profile
# is selected; the profile refuses to start without it (no fallback to LocalTTS),
# and also requires a configured voice id.
VOXVOICE_SECRET_CARTESIA_API_KEY=

# ─── Runtime transport + WebRTC signalling (M11.16.4) ──────────────────────
# Read ONLY by the WebRTC deployment application (`api.webrtc.app`), which is a
# separate entry point:
#
#   uvicorn "api.webrtc.app:build_webrtc_app" --factory
#
# The default application (`api.main:app`) reads none of these and is unchanged.
# Every default below is the pre-M11.16.4 behaviour: loopback transport, no
# signalling surface, no cross-origin access.
#
# `local` (default) or `webrtc`. `webrtc` selects the WHOLE real stack
# (bootstrap.REAL_PROVIDER_PROFILE) and requires the three provider credentials
# above plus VOXVOICE_TTS_VOICE_ID. Selecting it incompletely is a startup
# error, never a silent downgrade to the loopback.
RUNTIME_TRANSPORT=local
#
# Mounts /v1/webrtc/* and the reference browser client. Implied by
# RUNTIME_TRANSPORT=webrtc; set on its own only for signalling-level testing.
WEBRTC_SIGNALLING=false
#
# Comma-separated browser origins allowed to call the API. Empty (the default)
# adds NO CORS middleware at all. `*` is refused unless APP_ENV=dev. The
# reference client is served same-origin, so the common case needs nothing here.
WEBRTC_ALLOWED_ORIGINS=
#
# The voice id the real profile's TTS provider speaks with. Configuration, NOT a
# credential, and deliberately vendor-neutral — which provider is used is
# REAL_PROVIDER_PROFILE's to say (AR-21).
VOXVOICE_TTS_VOICE_ID=
#
# ICE servers offered to WebRTC peer connections (ADR-0054, M11.16.6).
# Comma-separated STUN URLs. EMPTY MEANS EXPLICITLY NONE: the composition root
# passes an empty ICE server list to the media library rather than omitting the
# configuration, because omitting it makes aiortc substitute a public STUN
# server of its own choosing (R-71).
#
#   empty            -> host candidates only; contacts nothing
#   stun:host:port   -> host + server-reflexive candidates
#   turn:/turns:     -> REFUSED at startup; TURN is not implemented here and is
#                       a deployment prerequisite, not a setting
#
# A host whose public IPv4 is 1:1 NAT-mapped rather than carried on its
# interface (the common cloud-VM shape) needs a STUN server here, or its only
# candidate is an unroutable private address.
VOXVOICE_ICE_STUN_URLS=

# ── Developer Platform console (Epic 12, M12.1 — ADR-0055) ─────────────────────
# Read only by the console application (`api.console.app:build_console_app`),
# which wraps the WebRTC application above and reads all of its settings too.
#
# Absolute path to a built console bundle (`npm run build` in console/ writes
# console/dist). Served at /console/. EMPTY (the default) serves no console.
# A path that is relative, missing, or has no index.html is a startup error,
# never a silent "no console".
VOXVOICE_CONSOLE_DIST=
#
# ── Console sign-in (M12.2) ──
# Who may create an account from the console:
#   first_run (default) — only while no account exists yet: the first local account
#   open                — anyone who can reach the API
#   closed              — nobody; use `python -m api.console.bootstrap_owner`
VOXVOICE_CONSOLE_SIGNUP=first_run
#
# `Secure` on the session cookie. Empty derives it from APP_ENV: off only for
# APP_ENV=dev (http://localhost cannot carry a Secure cookie), on everywhere else.
VOXVOICE_CONSOLE_COOKIE_SECURE=
#
# Console session lifetime: absolute hours, and minutes of inactivity before it
# lapses. The idle timeout may not exceed the absolute lifetime.
VOXVOICE_CONSOLE_SESSION_HOURS=12
VOXVOICE_CONSOLE_SESSION_IDLE_MINUTES=120
#
# Failed sign-ins allowed per (email, client) within the window before further
# attempts are refused with 429. In-process: correct for one local API process.
VOXVOICE_CONSOLE_LOGIN_MAX_FAILURES=10
VOXVOICE_CONSOLE_LOGIN_WINDOW_MINUTES=15
#
# ── Console runtime (M12.5) ──
# Start real-voice (RUNTIME_TRANSPORT=webrtc) sessions with audio-driven
# endpointing (finding F-7): without it, per-turn voice-to-voice latency is not
# measured. Ignored by the loopback profile, which has no voice activity
# detector. Set to false to fall back to recognizer-driven turns.
VOXVOICE_CONSOLE_AUDIO_ENDPOINTING=true
