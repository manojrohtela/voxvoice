# ─── VoxVoice Platform — example environment ───────────────────────────────
# Copy to `.env` and fill in. NEVER commit `.env`. All secrets are read from
# env; nothing is hardcoded. (Assume any keys previously seen in chat history
# are rotated — do not reuse old values.)

# App
APP_ENV=dev

# Engine selection — the ONLY place a consumer/operator picks the engine.
# Swapping engines must touch nothing but this value + the adapter code.
#   dograh   -> DograhAdapter (primary, web sessions working)
#   livekit  -> LiveKitAdapter (stub for now, raises NotImplementedError)
ENGINE=dograh

# Database. SQLite locally; swap for a Supabase/Postgres URL in prod with NO
# model changes, e.g. postgresql+psycopg://USER:PASS@HOST:5432/postgres
DATABASE_URL=sqlite:///./voxvoice.db

# ─── Dograh (self-hosted) ──────────────────────────────────────────────────
# VERIFIED against Dograh v1.35.0. REST API host root (the adapter appends
# /api/v1). Official compose maps the api service to host :8000; if 8000 is
# taken, remap it (this repo verified against :8010). The UI/embed host is :3010.
DOGRAH_BASE_URL=http://localhost:8000
DOGRAH_UI_BASE_URL=http://localhost:3010
# Dograh API key (Bearer). Create one in the Dograh UI (Settings → API keys) or
# via `POST /api/v1/user/api-keys` after signup/login; it looks like `dgr_…`.
DOGRAH_API_KEY=

# Shared secret Dograh must present (header x-engine-secret) when it POSTs
# transcript/call events back to /v1/engine/dograh/events. Generate a random
# value; this protects the ingestion endpoint.
ENGINE_CALLBACK_SECRET=change-me-engine-callback-secret

# ─── Webhooks out to consumers ─────────────────────────────────────────────
# Per SPEC §10 open-decision 4: webhook config defaults to columns on Org
# (webhook_url / webhook_secret). These two values are only fallbacks used
# when an Org has no webhook configured of its own.
DEFAULT_WEBHOOK_URL=
DEFAULT_WEBHOOK_SECRET=
